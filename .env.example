# Kaunta's Supabase project. Copy this file to .env.local and fill it in from
# Supabase: Project Settings → API Keys (the URL is under Data API / Project URL).
#
# Leave both empty and Kaunta runs as the browser demo (sample data, nothing
# leaves this browser). Fill both and restart `npm run dev` to use the server.
#
# VITE_SUPABASE_PUBLISHABLE_KEY is the "Publishable key" (starts sb_publishable_).
# It is public by design: it reaches only the functions the migrations grant
# (pairing, sync, sign-in, and kaunta_admin / kaunta_super, which check the
# session themselves). A project still on legacy keys can put its "anon"
# key here instead (VITE_SUPABASE_ANON_KEY is also read, as a fallback).
#
# Never put the secret key (sb_secret_…) or the service_role key in this file
# or anywhere in the app: anything named VITE_… is built into the web page.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Push notifications (OneSignal): dashboard → Settings → Keys & IDs.
# VITE_ONESIGNAL_APP_ID is the "OneSignal App ID" (a UUID). It is public: it only
# lets this site register for notifications. Leave it empty and push stays off.
# VITE_ONESIGNAL_SAFARI_WEB_ID is optional (older Safari on Mac; "web.onesignal.auto.…").
#
# The REST API key is secret: it never goes here. Put it, and the app id again,
# in Supabase Vault (SQL editor), where the server reads them to send:
#   select vault.create_secret('<App ID>', 'onesignal_app_id');
#   select vault.create_secret('<REST API Key>', 'onesignal_rest_api_key');
VITE_ONESIGNAL_APP_ID=
VITE_ONESIGNAL_SAFARI_WEB_ID=
