# Copy to .env.local and fill in from your Supabase project (Project Settings → API).
# Without these, Kaunta runs on the handoff sample data on each phone and nothing syncs.
#
# The anon key is meant to be public: it can only call the three sync functions
# (pair_device, sync_push, sync_pull). Never put the service_role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=
